# Local Docker Postgres from ../docker-compose.yml (port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/kognivera

PORT=3000
NODE_ENV=development

# Connection pool (design: max 20) and per-transaction lock wait
PG_POOL_MAX=20
LOCK_TIMEOUT_MS=2000

# Hot path: reserve inside one Postgres function (sql) or as a Node-side transaction (js)
HOLD_IMPL=sql
# Reject visibly sold-out requests without taking the row lock (off = always lock)
FAST_REJECT=on
# How long 'this row is full' is remembered in-process (ms); 0 disables the memory
SOLD_OUT_CACHE_MS=300
# Only for `npm run start:cluster` (multi-process). Workers x PG_POOL_MAX must stay under 100.
# WEB_CONCURRENCY=4

# Hold TTL (seconds) and expiry-worker cadence
HOLD_TTL_SECONDS=600
EXPIRY_INTERVAL_MS=30000
# set to "off" to disable the in-process worker
EXPIRY_WORKER=on

# Optional: pin the demo user (no auth in scope). Defaults to the first active INR user.
DEMO_USER_ID=

# Demo-only: lets POST /api/bookings force a saga failure (simulate_failure). Off in production.
ALLOW_FAULT_INJECTION=true

# Gemini NL search. Without a key the API falls back to a small English-only heuristic parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# comma-separated, tried in order if the primary is busy/retired/slow
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite

# Where the built-in load-test engine sends its HTTP requests (default: this server)
LOADTEST_BASE_URL=
CORS_ORIGIN=*
